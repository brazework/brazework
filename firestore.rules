rules_version = '2';

// Forge security rules.
// The database only lets people do what the app allows; hiding a button is never enough.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // ---------- Shared post checks (main feed and community posts) ----------

    function validNewPost(d) {
      return d.authorId == request.auth.uid
        && d.body is string && d.body.size() > 0 && d.body.size() <= 3000
        && d.likeCount == 0
        && d.get('commentCount', 0) == 0
        && d.get('kind', 'update') in ['update', 'question', 'result', 'project']
        && d.get('tags', []) is list && d.get('tags', []).size() <= 3
        && d.createdAt == request.time;
    }

    // The author can edit their own post, but not its counts or review status.
    function authorEdit() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0)
        && request.resource.data.get('status', 'visible') == resource.data.get('status', 'visible');
    }

    // Likes move by one, only together with adding or removing your own like.
    // Comment counts move by one (the app does this together with the comment).
    function counterUpdate(likeP) {
      return (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && ((request.resource.data.likeCount == resource.data.likeCount + 1 && !exists(likeP) && existsAfter(likeP))
              || (request.resource.data.likeCount == resource.data.likeCount - 1 && exists(likeP) && !existsAfter(likeP))))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) + 1
              || (request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) - 1
                  && resource.data.get('commentCount', 0) > 0)));
    }

    function validComment(d) {
      return d.keys().hasOnly(['authorId', 'authorFirst', 'authorLast', 'body', 'createdAt'])
        && d.authorId == request.auth.uid
        && d.body is string && d.body.size() > 0 && d.body.size() <= 1000
        && d.createdAt == request.time;
    }

    // ---------- Members ----------

    // Member profiles: verified members can read; you can only write your own.
    match /users/{uid} {
      allow read: if verified() || isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasAll(['firstName', 'lastName', 'accountType', 'birthday'])
        && request.resource.data.accountType in ['student', 'professional'];
      allow update: if isMe(uid)
        // These can never be changed by the member after sign-up.
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.birthday == resource.data.birthday;
      allow delete: if false;

      // Saved posts are private to their owner.
      match /saved/{postId} {
        allow read, write: if verified() && isMe(uid);
      }
    }

    // Organization interest from the landing page: anyone may submit one;
    // nobody can read, change or delete them from the site (view them in the Firebase console).
    match /orgInterest/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'name', 'contact', 'email', 'role', 'createdAt'])
        && request.resource.data.type in ['company', 'school']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.role is string && request.resource.data.role.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- Network ----------

    function userExists(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }
    function sortedPair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // Connections are two-way and start as a request. The record's ID is both members' IDs,
    // sorted and joined, so there can only ever be one between two people.
    // Accepted connections are visible to members (like a public connections list);
    // pending requests only to the two people involved.
    match /connections/{id} {
      allow read: if verified() && (resource == null
        || resource.data.status == 'accepted'
        || resource.data.from == request.auth.uid
        || resource.data.to == request.auth.uid);
      allow create: if verified()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == sortedPair(request.auth.uid, request.resource.data.to)
        && request.resource.data.users.hasOnly([request.auth.uid, request.resource.data.to])
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending'
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time
        && userExists(request.resource.data.to);
      // Only the person who received the request can accept it.
      allow update: if verified()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.acceptedAt == request.time;
      // Either person can decline, withdraw or remove.
      allow delete: if verified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Follows are one-way. ID is follower_target.
    match /follows/{id} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.createdAt == request.time
        && userExists(request.resource.data.target);
      allow update: if false;
      allow delete: if verified() && resource.data.follower == request.auth.uid;
    }

    // ---------- Main feed posts ----------

    match /posts/{postId} {
      allow read: if verified();
      allow create: if verified() && validNewPost(request.resource.data);
      allow update: if verified() && (authorEdit()
        || counterUpdate(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)));
      allow delete: if verified() && resource.data.authorId == request.auth.uid;

      // One like per member per post.
      match /likes/{uid} {
        allow read: if verified();
        allow create, delete: if verified() && isMe(uid);
      }

      // Comments: the commenter or the post's author can remove one.
      match /comments/{commentId} {
        allow read: if verified();
        allow create: if verified() && validComment(request.resource.data);
        allow update: if false;
        allow delete: if verified() && (resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }
    }

    // ---------- Communities ----------
    // Roles, highest first: owner 5, admin 4, moderator 3, helper 2, member 1.
    // Everyone can only act on people below their own role.

    function cPath(cid) { return /databases/$(database)/documents/communities/$(cid); }
    function memberPath(cid, uid) { return /databases/$(database)/documents/communities/$(cid)/members/$(uid); }
    function banPath(cid, uid) { return /databases/$(database)/documents/communities/$(cid)/bans/$(uid); }
    function roleRank(r) { return {'owner': 5, 'admin': 4, 'moderator': 3, 'helper': 2, 'member': 1}.get(r, 0); }
    function myRank(cid) {
      return exists(memberPath(cid, request.auth.uid)) ? roleRank(get(memberPath(cid, request.auth.uid)).data.role) : 0;
    }
    function isMemberOf(cid) { return exists(memberPath(cid, request.auth.uid)); }
    function canView(cid) { return get(cPath(cid)).data.privacy == 'public' || isMemberOf(cid); }

    // Lets the app list "your communities" (a search across every community's members).
    match /{path=**}/members/{memberId} {
      allow read: if verified();
    }

    match /communities/{cid} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.lastMemberChange == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 60
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.about is string && request.resource.data.about.size() <= 500
        && request.resource.data.privacy in ['public', 'approval']
        && request.resource.data.type in ['field', 'study', 'project', 'school']
        && request.resource.data.topics is list && request.resource.data.topics.size() <= 3
        && request.resource.data.rules is string && request.resource.data.rules.size() <= 1500
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(cid, request.auth.uid)).data.role == 'owner';
      allow update: if verified() && (
        // Admins and the owner edit the community's info and auto-moderation.
        (myRank(cid) >= 4
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'nameLower', 'about', 'rules', 'field', 'type', 'privacy', 'topics', 'automod'])
          && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 60
          && request.resource.data.nameLower == request.resource.data.name.lower()
          && request.resource.data.about.size() <= 500
          && request.resource.data.rules.size() <= 1500
          && request.resource.data.privacy in ['public', 'approval']
          && request.resource.data.type in ['field', 'study', 'project', 'school']
          && request.resource.data.automod.words is list
          && request.resource.data.automod.words.size() <= 50)
        ||
        // The member count moves by one, only together with that member actually joining or leaving.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'lastMemberChange'])
          && ((request.resource.data.memberCount == resource.data.memberCount + 1
                && !exists(memberPath(cid, request.resource.data.lastMemberChange))
                && existsAfter(memberPath(cid, request.resource.data.lastMemberChange)))
              || (request.resource.data.memberCount == resource.data.memberCount - 1
                && exists(memberPath(cid, request.resource.data.lastMemberChange))
                && !existsAfter(memberPath(cid, request.resource.data.lastMemberChange)))))
      );
      allow delete: if false;

      match /members/{uid} {
        allow read: if verified();
        allow create: if verified()
          && request.resource.data.uid == uid
          && (
            // Join a public community yourself, unless you've been banned from it.
            (isMe(uid) && request.resource.data.role == 'member'
              && get(cPath(cid)).data.privacy == 'public'
              && !exists(banPath(cid, uid)))
            ||
            // The founder becomes the owner when the community is created.
            (isMe(uid) && request.resource.data.role == 'owner'
              && !exists(cPath(cid)) && getAfter(cPath(cid)).data.ownerId == uid)
            ||
            // Helpers and above approve someone's pending request.
            (myRank(cid) >= 2 && request.resource.data.role == 'member'
              && exists(/databases/$(database)/documents/communities/$(cid)/requests/$(uid))
              && !exists(banPath(cid, uid)))
          );
        // Admins and the owner change roles, only for people below them and only to roles below their own.
        allow update: if verified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && myRank(cid) >= 4
          && roleRank(resource.data.role) < myRank(cid)
          && roleRank(request.resource.data.role) >= 1
          && roleRank(request.resource.data.role) < myRank(cid);
        // Leave yourself (the owner can't), or moderators and above remove people below them.
        allow delete: if verified() && (
          (isMe(uid) && resource.data.role != 'owner')
          || (myRank(cid) >= 3 && roleRank(resource.data.role) < myRank(cid)));
      }

      match /requests/{uid} {
        allow read: if verified() && (isMe(uid) || myRank(cid) >= 2);
        allow create: if verified() && isMe(uid)
          && request.resource.data.uid == uid
          && get(cPath(cid)).data.privacy == 'approval'
          && !exists(memberPath(cid, uid))
          && !exists(banPath(cid, uid));
        allow update: if false;
        allow delete: if verified() && (isMe(uid) || myRank(cid) >= 2);
      }

      match /bans/{uid} {
        allow read: if verified() && myRank(cid) >= 3;
        allow create: if verified() && myRank(cid) >= 3
          && exists(memberPath(cid, uid))
          && roleRank(get(memberPath(cid, uid)).data.role) < myRank(cid);
        allow update: if false;
        allow delete: if verified() && myRank(cid) >= 3;
      }

      // Community posts. Public communities: any verified member can read.
      // Approval-required communities: members only. Held posts: the author and moderators.
      match /posts/{pid} {
        allow read: if verified() && (
          (resource.data.status == 'visible' && canView(cid))
          || resource.data.authorId == request.auth.uid
          || myRank(cid) >= 3);
        allow create: if verified()
          && isMemberOf(cid)
          && validNewPost(request.resource.data)
          && request.resource.data.communityId == cid
          && request.resource.data.status in ['visible', 'held'];
        allow update: if verified() && (
          authorEdit()
          || (canView(cid) && counterUpdate(/databases/$(database)/documents/communities/$(cid)/posts/$(pid)/likes/$(request.auth.uid)))
          // Moderators approve held posts.
          || (myRank(cid) >= 3
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'visible'));
        allow delete: if verified() && (resource.data.authorId == request.auth.uid || myRank(cid) >= 3);

        match /likes/{uid} {
          allow read: if verified();
          allow create, delete: if verified() && isMe(uid) && canView(cid);
        }

        match /comments/{commentId} {
          allow read: if verified() && canView(cid);
          allow create: if verified() && isMemberOf(cid) && validComment(request.resource.data);
          allow update: if false;
          allow delete: if verified() && (resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/communities/$(cid)/posts/$(pid)).data.authorId == request.auth.uid
            || myRank(cid) >= 3);
        }
      }
    }
  }
}
