# You don't need this to develop: `npm run dev` starts a local database and sets these itself.
# The real values live in Vercel (Production: production's database; Preview: staging's).
# Same names Vercel's Supabase integration sets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
